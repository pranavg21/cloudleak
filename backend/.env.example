# --- Environment -------------------------------------------------------------
# "production" makes startup fail if authentication is not configured.
CLOUDLEAK_ENV=development

# --- Authentication ----------------------------------------------------------
# SHA-256 digests of valid API keys, comma-separated. Generate with:
#   python keygen.py "sales-demo"
# Plaintext keys are never stored server-side.
CLOUDLEAK_API_KEY_HASHES=

# --- CORS --------------------------------------------------------------------
CLOUDLEAK_ALLOWED_ORIGINS=http://localhost:3000

# --- Rate limiting -----------------------------------------------------------
CLOUDLEAK_RATE_LIMIT=10
CLOUDLEAK_RATE_LIMIT_WINDOW=60
CLOUDLEAK_MAX_JOBS_PER_KEY=3

# --- Queue -------------------------------------------------------------------
CLOUDLEAK_WORKERS=2
CLOUDLEAK_QUEUE_SIZE=64
CLOUDLEAK_JOB_TIMEOUT=120
CLOUDLEAK_JOB_TTL=900
CLOUDLEAK_MAX_UPLOAD_MB=150

# --- Optional: shared state across instances ---------------------------------
# Without this, rate limits and job state are per-process.
CLOUDLEAK_REDIS_URL=
