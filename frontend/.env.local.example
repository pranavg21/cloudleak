# Base URL of the CloudLeak API, used by the Next.js server only.
CLOUDLEAK_API_BASE_URL=http://localhost:8000

# API key for the backend. Deliberately NOT prefixed with NEXT_PUBLIC_:
# anything with that prefix is inlined into the browser bundle and handed to
# every visitor. Browser requests go to this app's own /api routes, which
# attach the key server-side.
CLOUDLEAK_API_KEY=paste-the-key-the-backend-printed-at-startup
